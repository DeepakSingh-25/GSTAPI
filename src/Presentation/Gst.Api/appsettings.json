{
  "ConnectionStrings": {
    "DefaultSchema": "dbo",
    "DefaultConnection": "Server=192.168.120.17;Database=Gst;User Id=developer;Password=CHANGE_ME;Encrypt=Optional;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "Gst",
    "Audience": "Gst.Client",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32_PLUS_CHARS",
    "Expiry": 15
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RememberMeDays": 30,
    "SessionHours": 12,
    "OtpResendCooldownSeconds": 60,
    "OtpMaxPerHour": 5,
    "RefreshReuseGraceSeconds": 30,
    "KeyRateLimitPermits": 10,
    "KeyRateLimitWindowMinutes": 10
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "GST Invoice",
    "PickupDirectory": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "AllowedOrigins": [ "http://localhost:4200" ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "Logs/gst-.log", "rollingInterval": "Day" }
      }
    ]
  },
  "AllowedHosts": "*"
}
