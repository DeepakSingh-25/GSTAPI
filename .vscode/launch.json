{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gst.Api (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Presentation/Gst.Api/bin/Debug/net10.0/Gst.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Presentation/Gst.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7100;http://localhost:5100"
      }
    }
  ]
}
